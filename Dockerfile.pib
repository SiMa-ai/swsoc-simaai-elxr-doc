#
# SiMa.ai Palette Image Builder (PIB) container.
#
# Assembles Modalix eLxr images (rootfs, disk image, signed .swu) from
# SiMa.ai's public apt repository plus the customer's own .debs (kernel,
# extra packages). It builds no packages and needs nothing from SiMa.ai
# beyond that repository: no package sources or cross toolchains are included
# (eLxr's python3-rucksack does pull in a native build-essential).
#
# Build context is this directory. dist/ holds the SiMa.ai pasha wheel
# (pasha-<release>-py3-none-any.whl, the rucksack image-build modules) and
# RELEASE the release it is for, both checked in by SiMa.ai for each release,
# and eLxr's elxr-config archive and amd64 base image tarball (see UPSTREAM).
# It builds on an amd64 (x86-64) host only:
#
#   sha256sum -c dist/elxr-base-bianca-26.04.02.sha256 &&
#     docker load -i dist/elxr-base-bianca-26.04.02-amd64.tar.gz &&
#     docker build -f Dockerfile.pib -t "sima-image-builder:$(cat RELEASE)" .
#
# The container needs
# --privileged for loop devices and LVM, and the
# host's /dev: a container's /dev is a snapshot taken at start, so the
# partition nodes "losetup --partscan" creates later (/dev/loopNpM) would
# never appear in it. host/pib wraps this for every pib command:
#
#   docker run --rm -it --privileged -v /dev:/dev -v "$PWD":/workspace \
#       -e PIB_UID=$(id -u) -e PIB_GID=$(id -g) \
#       sima-image-builder:<release> pib build
#
# .debs in /workspace/custom-debs are served to the build from a signed
# local repo that outranks SiMa.ai's packages (see entrypoint.sh).

# The base is eLxr's elxrlinux/elxr bianca-26.04.02, loaded from dist/ (see UPSTREAM);
# the apt packages below float with the eLxr mirror.
ARG BASE_IMAGE=elxr-base:bianca-26.04.02-amd64
FROM ${BASE_IMAGE}

# SiMa.ai's public apt repo; CODENAME names its suite for this release.
ARG SIMAAI_APT_URL=https://repo.sima.ai/elxr/deb/release
# Fingerprint of simaai-public.asc, the key SiMa.ai's public repo is
# signed with. The build refuses a key file that does not match it.
ARG SIMAAI_KEY_FPR=1E527426828B89232E080FD44F87A7B80CFC8F4B

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8

# rucksack and its helpers come from eLxr; prefer its builds over Debian's.
RUN printf 'Package: *\nPin: origin mirror.elxr.dev\nPin-Priority: 900\n' \
        > /etc/apt/preferences.d/99pablo-repository && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        gnupg \
        wget \
        python3-pip \
# Build backend for the pib package below; pip gets no index to fetch one.
        python3-setuptools \
# Image assembly: rucksack runs the stages, pasha (below) provides the
# modules. pasha's own Python dependencies come from Debian so the pip
# install of the wheel can skip PyPI.
        python3-rucksack \
        python3-stevedore \
        python3-yaml \
        python3-rich \
# Rootfs bootstrap: mmdebstrap runs arm64 maintainer scripts under
# qemu-user-static.
        mmdebstrap \
        arch-test \
        qemu-user-static \
        binfmt-support \
# "boot A/B + LVM" disk layout and its file systems.
        udev \
        kmod \
        parted \
        fdisk \
        lvm2 \
        dosfstools \
        mtools \
        e2fsprogs \
        cpio \
        gzip \
        xz-utils \
        zstd \
# Boot partition (FIT/boot.scr/env) and .swu signing.
        u-boot-tools \
        device-tree-compiler \
        openssl \
# PKCS#11 (HSM/YubiKey) signing: pib sign --pkcs11 uses the engine.
        libengine-pkcs11-openssl \
        opensc \
        libpcsclite1 \
# Local apt repo for the customer's .debs.
        reprepro \
        nginx && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# The release this image builds (pib refuses an image.yaml for another) and its eLxr
# suite; the image configs include both files.
COPY RELEASE /etc/pib-release
COPY CODENAME /etc/pib-codename
RUN CODENAME="$(cat /etc/pib-codename)" && \
    python3 -c 'import re, sys; sys.exit(not re.fullmatch(r"[a-z][a-z0-9]*", sys.argv[1]))' "$CODENAME" || \
    { echo "CODENAME must hold one suite name such as agate, not '$CODENAME'" >&2; exit 1; }

# Python packages come only from the bind-mounted dist/: debsbom pinned by hash, then
# pasha (--no-deps: its requirements are the python3-* above), checked for every module used.
RUN --mount=type=bind,source=dist,target=/tmp/dist \
    RELEASE="$(cat /etc/pib-release)" && \
    python3 -c 'import re, sys; sys.exit(not re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", sys.argv[1]))' "$RELEASE" || { echo "RELEASE must hold one <major>.<minor>.<patch>, not '$RELEASE'" >&2; exit 1; } && \
    test -f /tmp/dist/pasha-${RELEASE}-py3-none-any.whl || { echo "dist/pasha-${RELEASE}-py3-none-any.whl is missing: SiMa.ai packs and checks it in with RELEASE for each release" >&2; exit 1; } && \
    pip install --no-cache-dir --break-system-packages --no-index \
        --find-links /tmp/dist --require-hashes -r /tmp/dist/debsbom-requirements.txt && \
    pip install --no-cache-dir --no-deps --break-system-packages /tmp/dist/pasha-${RELEASE}-py3-none-any.whl && \
    python3 -c "from importlib.metadata import entry_points; \
missing = {'bootstrap.mmdebstrap', 'image.compress', 'image.raw', 'installer.disk.lvm', \
'installer.disk.lvm.teardown', 'installer.disk.parted', 'simaai.bootloader', \
'simaai.swupdate', 'utils.run_shell'} - set(entry_points(group='pasha.modules').names); \
assert not missing, f'pasha wheel lacks modules: {sorted(missing)}'"

# SiMa.ai apt key from the build context, checked to be exactly this one key; then the
# date of its signed InRelease, the entrypoint's SOURCE_DATE_EPOCH.
RUN --mount=type=bind,source=configs/images/files/simaai-public.asc,target=/tmp/simaai-public.asc \
    export GNUPGHOME="$(mktemp -d)" && \
    keys="$(gpg --show-keys --with-colons /tmp/simaai-public.asc | \
           awk -F: '$1 == "pub" { n++ } $1 == "fpr" && !f { f = $10 } END { print n, f }')" && \
    if [ "$keys" != "1 $SIMAAI_KEY_FPR" ]; then \
        echo "simaai-public.asc: keys and fingerprint '$keys', expected '1 $SIMAAI_KEY_FPR'" >&2; \
        exit 1; \
    fi && \
    gpg --dearmor < /tmp/simaai-public.asc > /usr/share/keyrings/simaai-public.gpg && \
    wget -q -O /tmp/InRelease "${SIMAAI_APT_URL}/dists/$(cat /etc/pib-codename)/InRelease" && \
    gpgv --keyring /usr/share/keyrings/simaai-public.gpg /tmp/InRelease && \
    date -u -d "$(sed -n 's/^Date: //p' /tmp/InRelease)" +%s > /etc/pib-release-epoch && \
    rm -r /tmp/InRelease "$GNUPGHOME"

# Local apt repo layout, served by nginx at http://localhost/deb/custom.
# No signing key is baked in: entrypoint.sh creates a fresh one on every container run, so
# no two customers (and no published image layer) share it.
COPY files/distributions /var/www/html/deb/custom/conf/distributions
RUN sed -i "s/@CODENAME@/$(cat /etc/pib-codename)/" /var/www/html/deb/custom/conf/distributions
COPY files/nginx.conf /etc/nginx/sites-enabled/default

# elxr-config 1.1.0+elxr14 (commit 75cce348412fb4e75e917ba424fcd1e057c8cdc7): GitLab's archive,
# checked in to dist/ and checked; the configs link to it. Orin boot images are left out.
ARG ELXR_CONFIG_SHA256=9cfd9cfb62f809b9a4293fe6352e2295ea1c3fdd3831d86ec6dbb3a68ff10d60
RUN --mount=type=bind,source=dist,target=/tmp/dist \
    T=/tmp/dist/elxr-config-1.1.0-elxr14.tar.gz && \
    echo "${ELXR_CONFIG_SHA256}  $T" | sha256sum -c - && \
    mkdir -p /usr/share/pib/elxr-config && \
    tar -xzf "$T" -C /usr/share/pib/elxr-config --strip-components=1 --exclude='esp.img'

# pib CLI, next to pasha so it matches this image's modules; --no-deps as for pasha.
# rw: setuptools builds in-tree, and those writes are discarded with the mount.
RUN --mount=type=bind,source=pib,target=/tmp/pib,rw \
    pip install --no-cache-dir --no-deps --break-system-packages --no-index \
        --no-build-isolation /tmp/pib && \
    pib --version

# The image configs and the files they need ship in the image; pib init copies
# them into a workspace (PIB_CONFIGS or --configs picks another set).
COPY configs/ /usr/share/pib/configs/
COPY scripts/ /usr/share/pib/scripts/
COPY --chmod=755 entrypoint.sh /usr/local/bin/pib-entrypoint

# SiMa.ai's repo for pib build, which makes the MIRROR_1 apt line of
# configs/images/image-stages.yaml from it and /etc/pib-codename. No SWU signing
# key is set or shipped; pib build uses a throwaway one and pib sign the customer's.
ENV PIB_SIMA_APT_URL=${SIMAAI_APT_URL}

WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/pib-entrypoint"]
CMD ["bash"]
